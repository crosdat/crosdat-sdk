{
  "name": "crosdat-sdk",
  "private": true,
  "description": "Official public TypeScript, Web Component, React, and MCP SDKs for the CROSDAT Clinical Intelligence Platform.",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "lint": "turbo run check-types",
    "test": "turbo run test",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "prettier": "^3.7.4",
    "turbo": "2.9.18",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "24"
  }
}
